{
  "expo": {
    "name": "El Puntero",
    "slug": "puntero",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "puntero",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.ikerlorente11.puntero",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#5b45e6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ikerlorente11.puntero"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0d0e12"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "El Puntero usa la cámara para leer el QR de emparejado que muestra el PC.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "El Puntero usa el giroscopio para mover el puntero girando el móvil (modo aire)."
        }
      ],
      "expo-font"
    ],
    "owner": "ikerlorente11",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "c03e735c-b6e1-432b-9c8a-2f9fb905e78a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c03e735c-b6e1-432b-9c8a-2f9fb905e78a"
    }
  }
}